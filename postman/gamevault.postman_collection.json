{
  "info": {
    "name": "GameVault API",
    "description": "Run the folders in order (Collection Runner). Set `assetApi` and `taskApi` to the Function URLs from .aws/outputs.json (no trailing slash). Covers the spec's section 9 checklist; each run cleans up after itself.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "assetApi",
      "value": "https://REPLACE.lambda-url.us-east-1.on.aws"
    },
    {
      "key": "taskApi",
      "value": "https://REPLACE.lambda-url.us-east-1.on.aws"
    }
  ],
  "item": [
    {
      "name": "0 Health / infrastructure",
      "item": [
        {
          "name": "Asset API health (Lambda + DynamoDB + S3)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{assetApi}}/health"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('assets table, folders table and bucket ok', () => { const c = pm.response.json().data.checks; pm.expect(c.assetsTable.ok).to.eql(true); pm.expect(c.foldersTable.ok).to.eql(true); pm.expect(c.bucket.ok).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Task API health (Lambda + DynamoDB)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{taskApi}}/health"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('tasks table ok', () => pm.expect(pm.response.json().data.checks.tasksTable.ok).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 Folders",
      "item": [
        {
          "name": "Create folder",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{assetApi}}/folders"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"postman-folder\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('folderId', pm.response.json().data.folderId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create nested folder",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{assetApi}}/folders"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"postman-child\",\"parentId\":\"{{folderId}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('childFolderId', pm.response.json().data.folderId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Duplicate name -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{assetApi}}/folders"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"POSTMAN-FOLDER\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "List folders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{assetApi}}/folders"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('contains created', () => pm.expect(pm.response.json().data.map(f => f.folderId)).to.include(pm.collectionVariables.get('folderId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Move folder into its child -> 400",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{assetApi}}/folders/{{folderId}}"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"parentId\":\"{{childFolderId}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
