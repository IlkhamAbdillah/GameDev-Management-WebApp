              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data; const e = d.tasks.find(x => x.taskId === pm.collectionVariables.get('taskId'));",
                  "pm.test('dates, status, assignee', () => { pm.expect(e.startDate).to.eql('2031-01-01'); pm.expect(e.dueDate).to.eql('2031-01-10'); pm.expect(e.status).to.eql('In Progress'); pm.expect(e.assignee).to.eql('QA'); });",
                  "pm.test('stats', () => pm.expect(d.stats).to.have.keys('total','done','completionRate','byStatus','overdue','dueSoon','unscheduled'));"
                ]
              }
            }
          ]
        },
