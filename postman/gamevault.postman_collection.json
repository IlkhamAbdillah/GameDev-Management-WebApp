    {
      "name": "3 Asset files (S3)",
      "item": [
        {
          "name": "Disallowed type -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{assetApi}}/assets/{{assetId}}/upload-url"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"virus.exe\",\n  \"fileSize\": 10\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Generate upload URL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{assetApi}}/assets/{{assetId}}/upload-url"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"model.glb\",\n  \"fileSize\": 16\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data; pm.collectionVariables.set('uploadUrl', d.uploadUrl); pm.collectionVariables.set('s3Key', d.s3Key);",
                  "pm.test('key scoped to asset', () => pm.expect(d.s3Key).to.include('assets/' + pm.collectionVariables.get('assetId') + '/'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload file to S3 (pre-signed PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "model/gltf-binary"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "0123456789abcdef"
            },
            "url": {
              "raw": "{{uploadUrl}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Save S3 key on the asset",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{assetApi}}/assets/{{assetId}}"
