          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data; pm.test('key stored', () => pm.expect(d.s3Key).to.eql(pm.collectionVariables.get('s3Key')));",
                  "pm.test('glb previewable', () => pm.expect(d.previewKind).to.eql('model'));",
                  "pm.collectionVariables.set('downloadUrl', d.downloadUrl);"
                ]
              }
            }
          ]
        },
